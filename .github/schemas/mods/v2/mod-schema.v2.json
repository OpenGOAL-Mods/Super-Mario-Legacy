{
  "$ref": "#/definitions/ModMetadata",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ModMetadata": {
      "additionalProperties": false,
      "properties": {
        "publishedDate": { "type": "string" },
        "schemaVersion": {
          "description": "Semantic Version",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(...))?(?:\\+(...))?$",
          "type": "string"
        },
        "supportedGames": {
          "items": {
            "enum": ["jak1", "jak2", "jak3", "jakx"],
            "type": "string"
          },
          "type": "array"
        },
        "version": {
          "description": "Semantic Version",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(...))?(?:\\+(...))?$",
          "type": "string"
        }
      },
      "required": ["schemaVersion", "version", "publishedDate", "supportedGames"],
      "type": "object"
    }
  }
}
