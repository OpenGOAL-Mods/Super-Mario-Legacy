;;-*-Lisp-*-
(in-package goal)

;; name: mario-menu-h.gc
;; name in dgo: mario-menu-h
;; dgos: ENGINE, GAME

(bundles "ENGINE.CGO" "GAME.CGO")

;; ---------------------------------------------------------------------------
;; Header for mario-menu.gc.
;;
;; Hosts the big data table (*sm64-sound-preview-list*) that backs the
;; debug-menu sound previewer, so mario-menu.gc itself stays focused on
;; the previewer process + Mario-options pause-menu wiring.  The list
;; is generated from third-party/libsm64/src/decomp/include/audio_defines.h
;; by a Python one-shot (see the comment below *sm64-sound-preview-list*),
;; so do not hand-edit individual entries — regenerate from the source
;; header if audio_defines.h ever changes.
;; ---------------------------------------------------------------------------

;; ---------------------------------------------------------------------------
;; sm64-sound-entry + *sm64-sound-preview-list* — 411 entries auto-derived
;; from audio_defines.h.  Each entry pairs a human-readable label with the
;; raw 32-bit SOUND_ARG_LOAD-encoded id passed to `pc-sm64-play-sound`.
;; Deduped by id so no clip plays twice while the previewer cycles.  Covers
;; every entry from the decomp header (bank 0 ACTION through bank 9 OBJ2),
;; including the "not verified" ones labelled `unknownNN` / `unkNN`.
;; ---------------------------------------------------------------------------

(deftype sm64-sound-entry (structure)
  ((name string)
   (id   uint32)))

(define *sm64-sound-preview-list*
  (new 'static 'boxed-array :type sm64-sound-entry
       (new 'static 'sm64-sound-entry :name "action teleport" :id #x0457c081)
       (new 'static 'sm64-sound-entry :name "mario here we go" :id #x240c8081)
       (new 'static 'sm64-sound-entry :name "mario waaaooow" :id #x2410c081)
       (new 'static 'sm64-sound-entry :name "mario mama mia" :id #x24208081)
