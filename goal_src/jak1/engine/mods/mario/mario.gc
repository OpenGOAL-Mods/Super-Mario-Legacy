;;-*-Lisp-*-
(in-package goal)

;; name: mario.gc
;; name in dgo: mario
;; dgos: ENGINE, GAME

(bundles "ENGINE.CGO" "GAME.CGO")
(require "engine/common-obs/process-drawable.gc")
(require "engine/common-obs/generic-obs.gc")
;; Pull in the lurkercrab type declaration so we can deftype
;; sm64-crab-shell as a subtype.  The lurkercrab .o itself is
;; promoted into GAME.CGO (see game.gd) so it's always linked.
(require "levels/beach/lurkercrab.gc")

;; ---------------------------------------------------------------------------
;; C++ damage function — registered via make_function_symbol_from_c in kmachine.
;; ---------------------------------------------------------------------------
(define-extern pc-sm64-damage-mario (function none))
(define-extern pc-sm64-delete-mario (function none))
(define-extern pc-sm64-heal-mario (function none))
(define-extern pc-sm64-full-heal-mario (function none))
(define-extern pc-sm64-star-dance-mario (function none))
;; Color / corpse-render bridges (kmachine.cpp).  pc-sm64-set-mario-color
;; takes a preset index (0..N-1, see kMarioColorPresets in libsm64_
;; integration.cpp).  pc-sm64-set-corpse-render-enabled takes 0/1.
(define-extern pc-sm64-set-mario-color (function int none))
(define-extern pc-sm64-set-corpse-render-enabled (function int none))

;; Health-sync bridges (kmachine.cpp).  Each routes Mario through a real
;; libsm64 special-state so the proper SM64 hurt animation + knockback
;; plays — no hacked wedge subtracts.
(define-extern pc-sm64-set-mario-wedges (function int none))    ; floor sync
(define-extern pc-sm64-knockback-mario  (function int none))    ; generic hit
(define-extern pc-sm64-burn-mario       (function int none))    ; lava bounce
(define-extern pc-sm64-drown-mario      (function none))        ; out-of-air kill
(define-extern pc-sm64-endlessfall-mario (function none))       ; OOB fatal kill
(define-extern pc-sm64-kill-mario       (function none))        ; sync death from Jak
;; Read-only: Mario's drowning timer (frames remaining), for the air HUD.
;; Returns a value 0..768 (libsm64 internal) — full breath is around 768,
;; underwater starts the countdown, surfacing refills.
(define-extern pc-sm64-get-mario-air    (function int))
;; Corpse: snapshot Mario's current mesh in world space and stash it in C++
;; so the dead body keeps rendering at the death location after Mario is
;; deleted + auto-respawned at Jak's checkpoint.  Capture APPENDS to a list
;; — every death leaves a corpse, all of them persist (across level changes
;; and save-load alike).  update-last replaces the last corpse in-place
;; (rolling capture during the death animation so the FINAL pose is what
;; sticks, without stacking N copies of Mario at the death spot).  Clear
;; wipes the entire list (debug / admin only — not wired into normal play).
(define-extern pc-sm64-capture-mario-corpse (function none))
(define-extern pc-sm64-update-last-mario-corpse (function none))
;; Promote the just-captured corpse to visible.  Called once on the falling
;; edge of Jak's dying state — until then the corpse is captured-but-hidden
;; so the user never sees a half-formed mid-animation pose next to live
;; Mario.  No-op if no pending corpse exists.
(define-extern pc-sm64-finalize-last-mario-corpse (function none))
(define-extern pc-sm64-clear-mario-corpse (function none))
(define-extern pc-sm64-play-sound (function int none))
(define-extern pc-sm64-play-music (function int none))
;; Variant that plays even while Jak's game is paused (title screen, menus).
;; Calling pc-sm64-play-music or pc-sm64-stop-music afterwards restores
;; the default pause-responsive behavior.
(define-extern pc-sm64-play-music-forced (function int none))
(define-extern pc-sm64-stop-music (function none))
;; Set SM64 audio output volume (0.0..100.0).  Applied to every sample
;; coming out of sm64_audio_tick — music and SFX alike.
(define-extern pc-sm64-set-music-volume (function float none))
(define-extern pc-sm64-teleport-mario (function float float float none))

;; Forward-decl: lives in mario-music.gc (loaded right after this file).
;; sm64-mario-col's idle loop calls it every tick to track level
;; transitions and mute Jak's music while SM64 music is enabled.
(define-extern update-mario-music! (function none))

;; The lurker-crab skelgroup is global now (see game.gd — `lurkercrab.o`
;; and `lurkercrab-ag.go` are promoted into GAME.CGO following the
;; FlutFlut Legacy pattern).  Forward-decl so the sm64-crab-shell
;; subtype below can reference the symbol at compile time.
(define-extern *lurkercrab-sg* skeleton-group)

;; ---------------------------------------------------------------------------
;; sm64-music — friendly-name helpers.  Map a GOAL symbol to the SM64
;; sequence id it corresponds to (see third-party/libsm64/src/decomp/include/
;; seq_ids.h).  Always stops whatever track is currently playing before
;; starting the new one, so two calls never layer.  Pass 'none / 'stop / #f
;; to stop audio.
;;
;; By default pause/resume is handled automatically in C++
;; (update_music_pause_state): the cubeb audio worker freezes while Jak's
;; game is paused, so the track pauses in-place and resumes seamlessly on
;; unpause.
;;
;; `sm64-music-forced` is the same but tells C++ to keep the audio worker
;; ticking even while the master-mode is outside 'game — use for title /
;; menu / save-select music where the game is "paused" by design but you
;; still want audio.  Calling the non-forced `sm64-music` (or stopping)
;; restores the default pause-responsive behavior on the next call.
;;
;; Examples:
;;   (sm64-music 'bob-omb)              ;; gameplay, pauses with menu
;;   (sm64-music-forced 'title)         ;; title screen, keeps playing
;;   (sm64-music 'none)                 ;; stop (also clears forced mode)
;; ---------------------------------------------------------------------------

;; Symbol -> SM64 seq id.  Returns 0 for stop, -1 for unknown.
(defun sm64-music-id ((track symbol))
  (case track
    (('none 'stop #f)             0)
    (('collect-star)              #x01)
    (('title)                     #x02)
    (('bob-omb 'grass)            #x03)
    (('inside-castle 'castle)     #x04)
    (('water 'dire-dire)          #x05)
    (('hot 'lava)                 #x06)
    (('boss-koopa 'bowser)        #x07)
    (('snow)                      #x08)
    (('slide)                     #x09)
    (('spooky 'bbh)               #x0A)
    (('piranha-plant)             #x0B)
    (('underground 'cave)         #x0C)
    (('star-select)               #x0D)
    (('powerup)                   #x0E)
    (('metal-cap)                 #x0F)
    (('koopa-message)             #x10)
    (('koopa-road)                #x11)
    (('high-score)                #x12)
    (('merry-go-round)            #x13)
    (('race)                      #x14)
    (('star-spawn)                #x15)
    (('boss 'mini-boss)           #x16)
    (('collect-key)               #x17)
    (('endless-stairs)            #x18)
    (('final-bowser 'bowser-final) #x19)
    (('credits)                   #x1A)
    (('solve-puzzle)              #x1B)
    (('toad-message)              #x1C)
    (('peach-message)             #x1D)
    (('intro)                     #x1E)
    (('victory)                   #x1F)
    (('ending)                    #x20)
    (('file-select)               #x21)
    (('lakitu)                    #x22)
    (else -1)))

;; Play a track that respects Jak's pause state (default behavior).  No-op
;; (and stops anything already playing) if the user has disabled SM64
;; music via *mario-settings*.
(defun sm64-music ((track symbol))
  (cond
    ((not (-> *mario-settings* play-sm64-music?))
     (pc-sm64-stop-music))
    (else
     (let ((id (sm64-music-id track)))
       (cond
         ((zero? id) (pc-sm64-stop-music))
         ((> id 0)   (pc-sm64-play-music id))
         (else
           (format 0 "sm64-music: unknown track ~A — stopping music~%" track)
           (pc-sm64-stop-music))))))
  (none))

;; Play a track that keeps going even while Jak's game is paused (title,
;; menus, file-select).  Switch back to `sm64-music` for in-game music.
;; Same disabled-by-settings short circuit as `sm64-music`.
(defun sm64-music-forced ((track symbol))
  (cond
    ((not (-> *mario-settings* play-sm64-music?))
     (pc-sm64-stop-music))
    (else
     (let ((id (sm64-music-id track)))
       (cond
         ((zero? id) (pc-sm64-stop-music))
         ((> id 0)   (pc-sm64-play-music-forced id))
         (else
           (format 0 "sm64-music-forced: unknown track ~A — stopping music~%" track)
           (pc-sm64-stop-music))))))
  (none))

;; ---------------------------------------------------------------------------
;; sm64-sound — friendly-name wrapper around pc-sm64-play-sound.
;;
;; Maps a GOAL symbol to the 32-bit SOUND_ARG_LOAD-encoded id libsm64
;; expects in sm64_play_sound_global.  Packing order (from audio_defines.h):
;;   bank      << 28
;;   playFlags << 24
;;   soundID   << 16
;;   priority  << 8
;;   flags2    << 4
;;   status         ← SOUND_STATUS_STARTING (= 1) OR'd into the low nibble
;;
;; **Important**: the low status nibble MUST be 1 (SOUND_STATUS_STARTING),
;; not 0.  The SM64 audio engine's dispatch rejects sounds whose status
;; byte is STOPPED, so e.g. `#x24218080` silently no-ops while
;; `#x24218081` plays — that one-bit difference is the whole reason
;; sounds may appear broken.
;;
;; Most Mario voice clips live in bank 2 with playFlags=4, priority=0x80,
;; flags2=8 → encoded as `#x24NN8081` where NN is the 2-digit hex soundID
;; (from audio_defines.h).  Clips with a different priority/flags use the
;; full SOUND_ARG_LOAD expansion + 1.  Menu / system sounds live in bank
;; 7 → `#x70NNFF81` for playFlags=0, priority=0xFF, flags2=8.
;;
;; Note: audio_defines.h itself defines SOUND_MARIO_OKEY_DOKEY as the
;; half-word 0x2021 — that value is the bank+soundID bits shifted into
;; the low half and will NOT play correctly if passed to libsm64.  We
;; use the full 32-bit encoding that matches every neighbouring Mario
;; sound in the bank-2 voice group.
;;
;; Extend by adding more cases below — each is a one-liner.  Remember
;; the trailing `1` status bit.
;; ---------------------------------------------------------------------------
(defun sm64-sound ((snd symbol))
  (case snd
    ;; ---- Iconic Mario voice (bank 2, standard priority) -----------------
    (('yahoo)                    (pc-sm64-play-sound #x24048081))  ;; classic "Yahoo!"
    (('hoo-hoo)                  (pc-sm64-play-sound #x24038081))  ;; short "Hoo hoo!"
    (('here-we-go)               (pc-sm64-play-sound #x240C8081))  ;; "Here we go!"
    (('mama-mia)                 (pc-sm64-play-sound #x24208081))
    (('oki-doki 'okey-dokey)     (pc-sm64-play-sound #x24218081))
    (('ground-pound-wah 'gp-wah) (pc-sm64-play-sound #x24228081))
    (('punch-yah)                (pc-sm64-play-sound #x241E8081))
    (('punch-hoo)                (pc-sm64-play-sound #x241F8081))
    (('punch-wah)                (pc-sm64-play-sound #x24248081))
    (('yahoo-waha-yippee 'jump)  (pc-sm64-play-sound #x242B8081))  ;; random Yahoo/Waha/Yippee
    (('doh)                      (pc-sm64-play-sound #x24308081))
    (('twirl-bounce)             (pc-sm64-play-sound #x24348081))
    (('so-long-bowser 'so-long-gay-bowser)
                                 (pc-sm64-play-sound #x24368081))
    (('ima-tired)                (pc-sm64-play-sound #x24378081))
    ;; ---- Mario voice with custom priority -------------------------------
    (('whoa)                     (pc-sm64-play-sound #x2408C081))  ;; priority 0xC0
    (('waaaoooow 'long-fall)     (pc-sm64-play-sound #x2410C081))  ;; falling scream, priority 0xC0
    (('on-fire)                  (pc-sm64-play-sound #x2414A081))  ;; priority 0xA0
    (('dying)                    (pc-sm64-play-sound #x2415FF81))  ;; priority 0xFF
    (('drowning)                 (pc-sm64-play-sound #x2423F081))  ;; priority 0xF0
    (('attacked)                 (pc-sm64-play-sound #x240AFF81))  ;; priority 0xFF
    (('game-over)                (pc-sm64-play-sound #x2431FF81))  ;; priority 0xFF
    (('hello 'its-a-me 'mario-hello)
                                 (pc-sm64-play-sound #x2432FF81))  ;; "It's-a me, Mario!" / "Hello"
    (('press-start)              (pc-sm64-play-sound #x2433FFA1))  ;; priority 0xFF, flags2 0xA
    ;; ---- Menu / system sounds (bank 7) ----------------------------------
    (('lets-a-go 'lets-go)       (pc-sm64-play-sound #x7024FF81))  ;; star-select "Let's-a go!"
    (('star-okey-dokey)          (pc-sm64-play-sound #x7023FF81))  ;; star-select "Okey dokey"
    ;; SOUND_MENU_CLICK_FILE_SELECT — the classic "whoosh" that plays on
    ;; the SM64 file-select / save-slot screen when a file is picked or
    ;; the screen itself whooshes in.  Encoded as
    ;; SOUND_ARG_LOAD(7, 0, 0x11, 0x00, 8) | SOUND_STATUS_STARTING.
    (('whoosh 'file-select-click) (pc-sm64-play-sound #x70110081))
    (else
      (format 0 "sm64-sound: unknown sound ~A~%" snd)))
  (none))

;; Toggle persistence for the `play-sm64-music?` setting.  Flips the flag,
;; commits *mario-settings* to disk, and stops any currently-playing track
;; if music was just turned off.  Returns the new (normalised) value.
(defun sm64-set-music-enabled! ((enabled? symbol))
  (set! (-> *mario-settings* play-sm64-music?) (if enabled? #t #f))
  (commit-to-file *mario-settings*)
  (when (not (-> *mario-settings* play-sm64-music?))
    (pc-sm64-stop-music))
  (-> *mario-settings* play-sm64-music?))

;; ---------------------------------------------------------------------------
;; Bridge globals — C++ libsm64 writes/reads these via EE memory each tick.
;; All data is packed into vectors (raw floats) to avoid fixnum/tag encoding.
;; ---------------------------------------------------------------------------

;; C++ writes: x,y,z = Mario world position (Jak units), w = face angle (GOAL degrees).
(define *sm64-mario-pos* (new 'static 'vector :x 0.0 :y 0.0 :z 0.0 :w 0.0))

;; C++ writes: x = punching/kicking (not dive/gp), y = ground-pound impact, z = ground-pound falling, w = diving.
(define *sm64-mario-info* (new 'static 'vector :x 0.0 :y 0.0 :z 0.0 :w 0.0))

;; C++ writes: x = health wedges (0.0–8.0).
(define *sm64-mario-health* (new 'static 'vector :x 0.0 :y 0.0 :z 0.0 :w 0.0))

;; GOAL writes: x = 1.0 if target grabbed (cutscene/periscope), y = 1.0 if periscope.
(define *sm64-target-flags* (new 'static 'vector :x 0.0 :y 0.0 :z 0.0 :w 0.0))

;; GOAL writes: #t while Jak is dying / being eaten / respawning.  C++ reads
;; this each frame and the renderer hides Mario for the duration so we don't
;; see Mario hanging in mid-air on a phantom shell while Jak's death animation
;; plays.  Cleared when the target's `dying` state-flag clears (post-respawn).
(define *sm64-jak-dying* #f)

;; Input bridge — GOAL pushes processed pad values to libsm64 every frame
;; via pc-sm64-set-input (kmachine.cpp registers this).  Mario inherits the
;; user's stick-deadzone setting (*pc-settings* stick-deadzone) and per-
;; button rebinding (cpad bits are post-rebinding) for free.
;;
;; Args: stick-x in -1..1 (right = +), stick-y in -1..1 (down = +), and a
;; button bitmask (bit 0 = A / cross, bit 1 = B / square|circle,
;; bit 2 = Z / L1|L2).
(define-extern pc-sm64-set-input (function float float int none))

;; GOAL writes x = 1.0 when Jak strikes Mario.  C++ reads + clears each tick.
(define *sm64-mario-hit* (new 'static 'vector :x 0.0 :y 0.0 :z 0.0 :w 0.0))

;; C++ writes: x = forward velocity (Jak units/frame), y = slide-kick active,
;;              z = jump-kick active, w = butt-slide active.
(define *sm64-mario-velocity* (new 'static 'vector :x 0.0 :y 0.0 :z 0.0 :w 0.0))

;; C++ writes: x = 1.0 if Mario is riding the koopa shell, 0.0 otherwise.
(define *sm64-mario-on-shell* (new 'static 'vector :x 0.0 :y 0.0 :z 0.0 :w 0.0))

;; C++ writes: damage-state info for the health sync.
;;   x = current damage mode (0=none, 1=lava, 2=drown, 3=endlessfall, 4=generic)
;;       set whenever Mario is in a libsm64 damage / dying special state so the
;;       sync block can propagate the right attack type to Jak.
;;   y = 1.0 if libsm64 invincibility frames are active (post-hit grace period)
;;   z = air supply (m->health, 0..2176) for the underwater air HUD
;;   w = 1.0 if Mario is in a submerged action (HUD shows air bar instead of HP)
(define *sm64-mario-damage* (new 'static 'vector :x 0.0 :y 0.0 :z 0.0 :w 0.0))

;; Time-frame deadline used by the "Mario just killed an enemy" sound
;; hook in target-handler.gc's 'get-attack-count case.  Bumped ~0.5s
;; into the future by every call to `sm64-spawn-attack-tracker` — an
;; enemy death that arrives while the current-time is still below this
;; deadline is attributed to Mario (vs Jak's own attacks, which don't
;; touch this timestamp).  0 means "Mario hasn't swung recently, any
;; enemy deaths in this window were Jak's doing."
(define *sm64-mario-attack-until* (the time-frame 0))

;; ---------------------------------------------------------------------------
;; HUD health override — display Mario's health (÷2) in place of Jak's.
;;
;; Mario's libsm64 health is tracked in *sm64-mario-health* x as 0.0..8.0
;; (eight wedges).  Jak's HUD health meter shows 0..3 segments.  To
;; "match the Jak world (4 hits instead of 8)", we halve Mario's value
;; and feed it to the meter's tally-value call — Mario's 8 wedges map
;; to 4 logical hits, capped to the 3 segments the meter can draw (so
;; full-health Mario shows a full meter, and the meter drains down as
;; Mario takes hits).
;;
;; Redefines `hud-update` for `hud-health`.  engine/ui/hud-classes.gc
;; (game.gp line 2010) installs the vanilla implementation; mario.gc
;; (line 2111) runs later, so this later definition wins at runtime.
;; When Mario is absent / dead / not spawned (health <= 0), we fall
;; back to Jak's native fact.health so the HUD still works outside
;; libsm64 mode.  health-pickup-time is threaded through unchanged so
;; the pickup-delay animation feels the same either way.
;; ---------------------------------------------------------------------------
(defmethod hud-update ((this hud-health))
  (cond
    ((and *target* (> (-> *sm64-mario-health* x) 0.0))
     ;; Clamp to 0 when Jak's own health is gone — the eco-pill buffer
     ;; can leave Mario with >0 wedges even while Jak is at 0 HP,
     ;; which would incorrectly display 1/4 on a dead Jak.
     (let ((display-hp (if (<= (-> *target* fact health) 0.0)
                           0
                           (the int (/ (-> *sm64-mario-health* x) 2.0)))))
       (tally-value this display-hp (the-as int (-> *target* fact health-pickup-time)))))
    (*target*
     (tally-value this
                  (the int (-> *target* fact health))
                  (the-as int (-> *target* fact health-pickup-time)))))
  0
  (none))

;; ---------------------------------------------------------------------------
;; sm64-mario-col — invisible process that tracks Mario's position and
;; spawns touch-tracker attack spheres for punches AND ground-pounds.
;;
;; Punch:        rising edge of *sm64-mario-info*.x → touch-tracker at
;;               Mario's fist (forward 1.5m, up 1m), radius 1.5m, 15 frames,
;;               sends 'attack 'punch.
;;
;; Ground pound: rising edge of *sm64-mario-info*.y → touch-tracker at
;;               Mario's feet, radius 3m, 10 frames, sends 'attack 'flop.
;;
;; Dive:         rising edge of *sm64-mario-info*.w → touch-tracker at
;;               Mario's body, radius 2m, 30 frames, sends 'attack 'punch.
;;               Tracks Mario's body as he slides forward.
;;
;; Enemy damage: handled in target-handler.gc (when Jak takes a hit,
;;               target-attacked also calls pc-sm64-damage-mario).
;;
;; Debug draw:   when *debug-segment* is on, draws Mario's body (red),
;;               punch reach (yellow), ground-pound AoE (blue).
;; ---------------------------------------------------------------------------

(deftype sm64-mario-col (process-drawable)
  ((prev-attacking    symbol)
   (prev-ground-pound symbol)
   (prev-diving       symbol)
   (prev-slide-kick   symbol)
   (prev-jump-kick    symbol)
   (prev-butt-slide   symbol)
   (mario-dead        symbol)
   (death-timer       int)
   (prev-jak-health   float)
   (prev-mario-wedges int)
   (prev-on-shell     symbol)
   (shell-tracker-timer int)
   ;; Handle to the spawned sm64-crab-shell visual (see
   ;; spawn-sm64-crab-shell below).  Non-zero while Mario is on the
   ;; shell, (the-as handle 0) otherwise.  Shell follows Mario via
   ;; its own :trans; the falling edge in our idle loop deactivates it.
   (shell-proc        handle))
  (:state-methods
    idle))

;; ---------------------------------------------------------------------------
;; sm64-crab-shell — Mario's shell-ride visual.
;;
;; Subtype of `lurkercrab` (global actor since game.gd promotion — see
;; comment at top of this file).  We inherit every slot + method the
;; real crab has, but override the init + state machine so the process
;; never touches nav-mesh, navigation, or collision AI — none of which
;; exist outside a proper level with a nav-mesh.
;;
;; How it stays crash-free:
;;   - `sm64-crab-shell-init` replicates the collide-shape allocation
;;     from `lurkercrab`'s init-from-entity! (needed because the
;;     `collide-info` field is typed collide-shape-moving in the parent
;;     deftype and transform-post casts to it) but SKIPS
;;     `init-defaults!`.  init-defaults! is where `(new 'process
;;     'nav-control ...)` gets created, which is what crashes when the
;;     level has no nav-mesh.
;;   - `sm64-crab-shell-idle` is a custom state that never transitions
;;     to any nav-enemy state.  Neck joint, pursuit, patrol, notice,
;;     attack — all dead code for us.
;;   - The process name is "sm64-crab-shell" so game-info.gc's
;;     initialize! teleport path can clean us up via kill-by-name
;;     before the old level unloads.
;; ---------------------------------------------------------------------------

(deftype sm64-crab-shell (lurkercrab)
  ())

(defstate sm64-crab-shell-idle (sm64-crab-shell)
  :trans (behavior ()
    ;; Self-terminate on any invariant break.  Mario off the shell,
    ;; target gone mid-teleport, level gone — all reasons to bail so
    ;; we don't keep a dangling process around references freed memory.
    (cond
      ((not *target*)
       (deactivate self))
      ((< (-> *sm64-mario-on-shell* x) 0.5)
       (deactivate self))
      ((not *level*)
       (deactivate self))
      (else
       ;; Pin the shell's world transform to Mario every frame.
       ;; *sm64-mario-pos* is refreshed by write_mario_bridge_data
       ;; (libsm64_integration.cpp) on each SM64 tick — x/y/z are in
       ;; Jak units, w is face angle in GOAL rotation units (65536
       ;; per full turn, same as quaternion-axis-angle! expects).
       (let ((root (-> self collide-info)))
         (when root
           (set! (-> root trans x) (-> *sm64-mario-pos* x))
           (set! (-> root trans y) (-> *sm64-mario-pos* y))
           (set! (-> root trans z) (-> *sm64-mario-pos* z))
           (set! (-> root trans w) 1.0)
           (quaternion-axis-angle! (-> root quat)
                                   0.0 1.0 0.0
                                   (-> *sm64-mario-pos* w)))))))
  :code (behavior ()
    ;; Pin peek-ja at frame 1 — fully-retracted pose so the crab reads
    ;; as a closed shell.  The lurkercrab idle-anim is frame-0 of the
    ;; walk cycle which shows legs/eyes, not what we want.
    (ja-channel-set! 1)
    (ja :group! lurkercrab-peek-ja :num! (identity (ja-aframe 1.0 0)))
    (loop (suspend)))
  ;; transform-post = ja-post (skeleton) + update-transforms! on the
  ;; collide-shape root.  We have a collide-shape-moving (inherited
  ;; from nav-enemy's root type), so this is the correct post.
  :post transform-post)

(defbehavior sm64-crab-shell-init sm64-crab-shell ()
  "Minimal init for the shell visual.  Does what
   `lurkercrab::init-from-entity!` does MINUS:
     - init-defaults! (creates nav-control — needs nav-mesh)
     - process-drawable-from-entity! (needs an entity)
     - particles (group-lurkercrab-slide — cosmetic, skip)
     - the final `(go nav-enemy-idle)` (we go to our own state)

   Entity-less by design: initialize-skeleton's no-entity fallback
   uses `(-> *level* level-default art-group)` as the art-group
   load-dir.  lurkercrab-ag is in GAME.CGO (see game.gd), which on
   boot registers into level-default via joint.gc's art-group
   login — so the load-to-heap-by-name lookup hits the cached entry
   without ever re-loading from disk.  This avoids the
   cross-teleport art-group reload loop that was pushing the global
   heap into type-table territory and zeroing/scribbling random
   types (font-context, etc).

   `collide-with` and `collide-as` are 0 so the shell is invisible
   to Jak's and enemies' collision systems.  Render-only."
  (let ((cshape (new 'process 'collide-shape-moving self (collide-list-enum usually-hit-by-player))))
    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
    (set! (-> cshape reaction) default-collision-reaction)
    (set! (-> cshape no-reaction)
          (the-as (function collide-shape-moving collide-shape-intersect vector vector none) nothing))
    (let ((prim (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (the-as collide-kind 0))
      (set! (-> prim collide-with)          (the-as collide-kind 0))
      (set-vector! (-> prim local-sphere) 0.0 0.0 0.0 2048.0)
      (set-root-prim! cshape prim))
    (set! (-> cshape nav-radius) 0.0)
    (backup-collide-with-as cshape)
    (set! (-> self collide-info) cshape))
  ;; Start pinned to Mario (idle :trans keeps us there every frame after).
  (set! (-> self collide-info trans x) (-> *sm64-mario-pos* x))
  (set! (-> self collide-info trans y) (-> *sm64-mario-pos* y))
  (set! (-> self collide-info trans z) (-> *sm64-mario-pos* z))
  (set! (-> self collide-info trans w) 1.0)
  (quaternion-identity! (-> self collide-info quat))
  ;; 15% smaller than the natural lurker-crab.
  (set-vector! (-> self collide-info scale) 0.65 0.45 0.65 1.0)
  ;; Merc skeleton load — uses level-default's art-group load-dir
  ;; (lurkercrab-ag is cached there from GAME.CGO boot, see docstring).
  (initialize-skeleton self *lurkercrab-sg* '())
  (update-transforms! (-> self collide-info))
  (set-vector! (-> self root scale) 0.65 0.45 0.65 1.0)
  (go sm64-crab-shell-idle))

(defmethod deactivate ((this sm64-crab-shell))
  "Belt-and-suspenders cleanup on shell teardown.  Hides the draw
   control and clears the skeleton BEFORE chaining to the parent
   lurkercrab / process-drawable deactivate so any render-thread
   dispatch that's mid-frame skips our entry via the `hidden` gate
   in dma-add-process-drawable / drawable.gc:448.  Without this,
   a teleport sequence that kills us while firecanyon is unloading
   can race the render thread into reading our draw's stale
   texture / merc references."
  (when (-> this draw)
    (logior! (-> this draw status) (draw-status hidden no-anim no-skeleton-update)))
  ;; Chain to parent — lurkercrab inherits process-drawable's
  ;; deactivate (no override), which cleans particles / sound and
  ;; calls process's deactivate (which runs process-disconnect).
  ((method-of-type process-drawable deactivate) this)
  (none))

(defun spawn-sm64-crab-shell ()
  "Spawn a sm64-crab-shell process near Mario.  Entity-less —
   initialize-skeleton falls through to level-default which has
   lurkercrab-ag cached from GAME.CGO's boot-time art-group login.
   No art-group reload per spawn, so rapid remount/teleport cycles
   don't accumulate allocations in the global heap."
  (process-spawn sm64-crab-shell
                 :init sm64-crab-shell-init
                 :name "sm64-crab-shell"))

;; ---- Helper: spawn a touch-tracker, clear its collide-as, configure event --

(defun sm64-spawn-attack-tracker ((parent process) (pos vector) (radius float)
                                  (dur int) (attack-mode symbol))
  "Spawn a touch-tracker at pos with given radius/duration/attack-mode.
   Spawns :to *target* so the tracker's parent is Jak — this makes the
   touch-tracker's event dispatch treat the attack as coming from target
   (branch 2 in touch-tracker-idle), which matches what every enemy's
   attack-handler expects (e.g. bully checks (= (-> arg0 type) target),
   bonelurker queries *target*'s powerups, etc).  Without this enemies
   silently ignore Mario's attacks because arg0 isn't target.
   We keep the tracker's default collide-as=(target enemy) — clearing it
   broke mutual visibility for enemies whose collide-with requires target
   (plant-boss, bonelurker's body prims, bully).  The touch-tracker's
   'touched handler already filters out the parent process, so Jak won't
   reverse-match his own Mario-spawned tracker."
  (let ((tracker (process-spawn touch-tracker
                   :init touch-tracker-init
                   pos radius dur
                   :to (if *target* *target* parent))))
    (when tracker
      ;; Configure the event it sends on contact.
      (send-event (ppointer->process tracker) 'event 'attack attack-mode))
    ;; libsm64 kill-detection hook: open a 30-frame "Mario just swung"
    ;; window.  nav-enemy-attack-handler (nav-enemy.gc:96) sends
    ;; 'get-attack-count to its attacker the instant it goes into its
    ;; die state, and *target*'s handler (target-handler.gc:59) catches
    ;; that.  We don't modify the enemy path at all — instead we
    ;; intercept at target's side: if a 'get-attack-count event arrives
    ;; while this window is open, it's almost certainly Mario's kill
    ;; (Jak himself could be swinging simultaneously, a rare false
    ;; positive) and we roll 5% for the "so long-a Bowser!" quip.
    (set! *sm64-mario-attack-until* (+ (current-time) (seconds 0.5)))
    tracker))

;; ---- States -----------------------------------------------------------------

(defstate idle (sm64-mario-col)
  :virtual #t
  :code (behavior ()
    (set! (-> self prev-attacking) #f)
    (set! (-> self prev-ground-pound) #f)
    (set! (-> self prev-diving) #f)
    (set! (-> self prev-slide-kick) #f)
    (set! (-> self prev-jump-kick) #f)
    (set! (-> self prev-butt-slide) #f)
    ;; Start as #t so the initial health=0.0 (before C++ writes) doesn't
    ;; false-trigger the death chain.  Clears to #f once C++ reports health > 0.
    (set! (-> self mario-dead) #t)
    (set! (-> self death-timer) 0)
    (set! (-> self prev-jak-health) 0.0)
    (set! (-> self prev-mario-wedges) 0)
    (loop
      ;; ---- Music orchestration (mute Jak music + pick SM64 track) ----
      (update-mario-music!)

      ;; ---- Push persisted Mario settings to C++ each frame ---------------
      ;; Cheap idempotent stores (atomic int set + bool set).  Doing it
      ;; every frame means any change to *mario-settings* — whether from
      ;; the debug menu, the pause menu, or a settings file reload —
      ;; takes effect on the next frame without needing per-toggle hooks
      ;; everywhere it might be edited.
      (pc-sm64-set-mario-color (-> *mario-settings* mario-color))
      (pc-sm64-set-corpse-render-enabled
        (if (-> *mario-settings* render-corpses?) 1 0))

      ;; ---- Mario death → kill Jak, wait for respawn, THEN despawn Mario ----
      (let ((dead (< (-> *sm64-mario-health* x) 0.5)))
        ;; Rising edge: Mario just died — kill Jak, append the FIRST corpse
        ;; for this death, start the death timer.
        (when (and dead (not (-> self mario-dead)))
          (format #t "[sync-debug] MARIO-DEAD rising: mario-w=~D prev=~D jak-hp=~f dmg.x=~D submerged=~A~%"
                  (the int (-> *sm64-mario-health* x))
                  (-> self prev-mario-wedges)
                  (-> *target* fact health)
                  (the int (-> *sm64-mario-damage* x))
                  (> (-> *sm64-mario-damage* w) 0.5))
          (format #t "[sm64] Mario died! Killing Jak...~%")
          ;; Append a fresh corpse for THIS death.  Every subsequent frame
          ;; while Jak is dying we'll REPLACE this same slot via update-
          ;; last so we end up with exactly one corpse per death (with the
          ;; final pose), not one corpse per frame stacked on top of each
          ;; other.  Past-me did the latter and the user found Mario
          ;; meeting himself five times in the same place.  Sorry.
          (pc-sm64-capture-mario-corpse)
          (send-event *target* 'attack-invinc #f (static-attack-info ((mode 'endlessfall))))
          (set! (-> self death-timer) 1))
        (set! (-> self mario-dead) dead))

      ;; ---- Rolling corpse update (replace the just-appended slot) -------
      ;; While Mario is dead AND Jak is still in his dying state, refresh
      ;; the LAST corpse with Mario's current geometry.  Each call
      ;; overwrites in-place — so 60 frames of dying-animation become 60
      ;; replaces of one slot, not 60 separate corpses.  The final
      ;; overwrite lands on the last frame before Jak's dying flag clears
      ;; (same frame teleport-Mario-to-Jak runs), so the locked-in pose
      ;; is Mario's full death animation frame at the death LOCATION.
      ;;
      ;; Edge cases:
      ;;  - If the rising-edge capture above didn't fire (e.g. mario was
      ;;    "dead" from libsm64's point of view but the rising-edge
      ;;    detector missed it), update-last is a no-op against an empty
      ;;    list — so worst case we end up with no corpse for this death,
      ;;    not with a corpse at the wrong place.
      ;;  - If Mario dies while Jak is ALREADY dying from another cause
      ;;    (shell-mount sync), the rising-edge fires and the gate works.
      (when (and (-> self mario-dead)
                 *target*
                 (logtest? (-> *target* state-flags) (state-flags dying)))
        (pc-sm64-update-last-mario-corpse))

      ;; While waiting, count frames then delete Mario once Jak has respawned
      (when (> (-> self death-timer) 0)
        (+! (-> self death-timer) 1)
        (when (or
                ;; After min delay, Jak is alive and no longer dying → respawned
                (and (> (-> self death-timer) 90)
                     *target*
                     (not (logtest? (-> *target* state-flags) (state-flags dying))))
                ;; Safety cap: force delete after ~20 seconds
                (> (-> self death-timer) 600))
          (format #t "[sm64] Jak respawned — finalizing corpse + deleting Mario for fresh spawn.~%")
          ;; Promote the rolling-captured corpse from pending → visible.
          ;; Until this call the renderer was skipping it (so the user
          ;; never saw a half-formed mid-animation corpse next to live
          ;; Mario during Jak's death window).  Has to happen BEFORE the
          ;; delete so the corpse appears the same frame live Mario
          ;; disappears — no flicker gap.
          (pc-sm64-finalize-last-mario-corpse)
          (pc-sm64-delete-mario)
          (set! (-> self death-timer) 0)))

      ;; ---- Write target state flags for C++ ----
      (let ((grabbed #f)
            (periscope #f)
            (clone-anim #f)
            (jak-dying #f))
        (when *target*
          (let ((st (-> *target* state)))
            (when st
              (set! grabbed (logtest? (-> *target* state-flags) (state-flags grabbed)))
              (set! periscope (or (= (-> st name) 'target-periscope)
                                  (logtest? (-> *target* state-flags) (state-flags first-person-mode))))
              ;; clone-anim = blue eco doors/bridges/fuel-cell pickups — grabbed but
              ;; should NOT teleport Mario (causes shove).  Mario just stays put.
              (set! clone-anim (= (-> st name) 'target-clone-anim))
              ;; jak-dying = death modes where Jak gets yanked / dissolved out
              ;; from under Mario, leaving Mario visibly hovering in mid-air on
              ;; a phantom shell.  Only these specific modes hide him; pit
              ;; falls, eco damage, lava, etc. leave Mario visible so he dies
              ;; alongside Jak normally.
              ;;   'sharkey       — lurker-shark grab (sharkey.gc:271)
              ;;   'dark-eco-pool — dissolves Jak underwater (water.gc:943)
              ;; Cleared once the dying flag drops on respawn.
              (let ((mode (-> *target* attack-info mode)))
                (set! jak-dying (and (logtest? (-> *target* state-flags) (state-flags dying))
                                     (or (= mode 'sharkey)
                                         (= mode 'dark-eco-pool))))))))
        (set! (-> *sm64-target-flags* x) (if grabbed 1.0 0.0))
        (set! (-> *sm64-target-flags* y) (if periscope 1.0 0.0))
        (set! (-> *sm64-target-flags* z) (if clone-anim 1.0 0.0))
        (set! *sm64-jak-dying* (if jak-dying #t #f))
        ;; w = in-movie flag.  `(movie?)` is the authoritative check — it
        ;; looks at *kernel-context* prevent-from-run for the movie
        ;; process-mask bit, which scene-player-driven cutscenes set
        ;; whether or not they change master-mode.  C++ reads this off
        ;; the bridge and uses it to (a) skip the pause early-return
        ;; during movies and (b) override the clone-anim-skip in the
        ;; cutscene teleport gate so Mario follows Jak's animating
        ;; skeleton through the whole movie instead of staying put.
        (set! (-> *sm64-target-flags* w) (if (movie?) 1.0 0.0)))

      ;; ---- Pad bridge: push processed input to libsm64 ------------------
      ;; cpad-list buttons are already post-rebinding (input-settings.json
      ;; maps physical buttons to cpad bits at the C++ input layer), and
      ;; we apply the GOAL-side *pc-settings* stick-deadzone here so Mario
      ;; inherits all the user's input settings.
      (let* ((pad         (-> *cpad-list* cpads 0))
             ;; Normalize raw -1..1.  PS2 sign convention: right = +x, down = +y.
             (raw-x       (* 0.0078125 (the float (- (the int (-> pad leftx)) 127))))
             (raw-y       (* 0.0078125 (the float (- (the int (-> pad lefty)) 127))))
             (deadzone    (-> *pc-settings* stick-deadzone))
             (mag         (sqrtf (+ (* raw-x raw-x) (* raw-y raw-y))))
             (out-x       0.0)
             (out-y       0.0))
        (when (< deadzone mag)
          ;; Radial deadzone: rescale (deadzone..1) to (0..1) so movement
          ;; right at the edge isn't half-speed.
          (let ((scale (/ (- mag deadzone) (* mag (- 1.0 deadzone)))))
            (set! out-x (* raw-x scale))
            (set! out-y (* raw-y scale))))
        ;; Buttons via cpad-hold? — same predicate Jak uses, so user
        ;; rebindings already took effect at the C++ input layer.
        ;;
        ;; Z-button (crouch / long-jump): L1, L2, OR R1.  The R1 binding is
        ;; safe in JAK 1 only — this file lives under goal_src/jak1/, so it
        ;; only ever loads in the jak1 build.  If you ever port this mod to
        ;; jak2/jak3, REMOVE r1 from the OR: jak2/3 uses R1 to shoot things
        (let ((btns (logior (if (cpad-hold? 0 x)                                  1 0)
                            (logior (if (or (cpad-hold? 0 square) (cpad-hold? 0 circle)) 2 0)
                                    (if (or (cpad-hold? 0 l1)
                                            (cpad-hold? 0 l2)
                                            (cpad-hold? 0 r1))                          4 0)))))
          (pc-sm64-set-input out-x out-y btns)))

      ;; ---- Health synchronization (Jak ↔ Mario) ---------------------------
      ;;
      ;; HISTORICAL HACKS (now removed, kept here for reference in case the
      ;; new design has a regression and we need to compare):
      ;;   - Old code only synced one direction: Jak heal → Mario heal.
      ;;     Damage went the other way through `*sm64-mario-hit*` (Jak
      ;;     punched Mario → C++ saw flag → called pc-sm64-damage-mario).
      ;;   - Mario death triggered Jak via `(send-event *target* 'attack-invinc
      ;;     #f (static-attack-info ((mode 'endlessfall))))`, then waited
      ;;     for Jak respawn before deleting Mario (still done below in the
      ;;     `mario-dead → kill Jak → wait → delete Mario` loop).
      ;;   - Eco-pill bonus was a 0/1 boolean (full or not), so the visible
      ;;     +1 HP from picking it up popped instead of progressing.
      ;;   - No floor sync: any missed event drifted forever.  Common
      ;;     desyncs were Mario taking lava damage Jak never saw, or Jak
      ;;     getting hit during a frame Mario was being teleported.
      ;;
      ;; NEW DESIGN (Jak is the source of truth):
      ;;   target_wedges = jak_hp * 2 + (eco_pill / 50 * 2)
      ;;   Each frame we clamp Mario's wedges to target_wedges (the floor —
      ;;   prevents drift no matter what events fire).  On top of the floor
      ;;   we route real damage events through libsm64's proper take-damage
      ;;   path so Mario plays the hurt animation + knockback (NOT a hacked
      ;;   wedge subtract), and propagate Mario's libsm64-side damage back
      ;;   into Jak via attack-invinc with mode-translated subtypes.  See
      ;;   the design doc / chat for full rules.
      (when (and *target* (not (-> self mario-dead)))
        (let* ((jak-hp        (-> *target* fact health))
               (jak-eco       (-> *target* fact eco-pill))
               (jak-eco-max   (-> *target* fact eco-pill-max))
               ;; Eco pill contributes 0..2 wedges progressively, BUT only
               ;; when Jak has at least 1 HP.  The eco pip is a buffer ABOVE
               ;; base health, not a replacement — if Jak is at 0/3 HP he's
               ;; dying, and Mario should be dead too regardless of how
               ;; charged the pip is.  Otherwise the user sees Mario walk
               ;; around with 2 wedges while Jak's death animation plays.
               ;; eco-pill / eco-pill-max are FLOATS — comparing to int 0
               ;; was reading the bytes as garbage.  Use 0.0 + the float.
               (eco-wedges    (if (and (> jak-hp 0.0) (> jak-eco-max 0.0))
                                  (the int (/ (* jak-eco 2.0) jak-eco-max))
                                  0))
               (target-wedges (min 8 (+ (the int (* jak-hp 2.0)) eco-wedges)))
               (mario-wedges  (the int (-> *sm64-mario-health* x)))
               (jak-edge      (< jak-hp (-> self prev-jak-health)))
               ;; Mario edge = libsm64 actually subtracted wedges since last
               ;; frame.  We DO NOT fire on `mario-wedges < target-wedges`
               ;; alone — that includes the Jak-just-healed case (target
               ;; went up, Mario sits at last frame's value), which would
               ;; bogus-attack Jak when he should be healing.  Only when
               ;; Mario's actual count fell does this represent damage to
               ;; propagate.
               (mario-edge    (and (not jak-edge)
                                   (< mario-wedges (-> self prev-mario-wedges)))))

          ;; Track what mario-wedges should be NEXT frame after our
          ;; intervention, used to update prev-mario-wedges so the
          ;; mario-edge detector doesn't fire on our own forced changes.
          ;; Default = current mario-wedges (no intervention).
          (let ((expected-next-mario-wedges mario-wedges))

           (cond
            ;; (1) Jak took damage this frame — route into Mario via libsm64
            ;; take-damage so the proper SM64 hurt anim + knockback plays.
            ;; All branches reduce Mario's wedges to target, so prev should
            ;; track target (not the stale current) — otherwise next
            ;; frame's mario-edge fires bogus attacks at Jak.
            (jak-edge
             (set! expected-next-mario-wedges target-wedges)
             (let ((damage-wedges (the int (* (- (-> self prev-jak-health) jak-hp) 2.0)))
                   (mode (-> *target* attack-info mode))
                   (submerged (> (-> *sm64-mario-damage* w) 0.5)))
               (format #t "[sync-debug] JAK-EDGE jak-hp:~f->~f mario-w:~D->target:~D mode=~A submerged=~A~%"
                       (-> self prev-jak-health) jak-hp mario-wedges target-wedges mode submerged)
               (cond
                 ((= mode 'lava)
                  (format #t "[sync-debug]   -> BURN ~D wedges~%" damage-wedges)
                  (pc-sm64-burn-mario damage-wedges))
                 ;; 'drown-death is the FATAL instant-kill mode (deep dark
                 ;; eco / dark-eco-pool / out-of-air).  Triggers libsm64's
                 ;; drowning death animation.  The plain 'drown periodic
                 ;; tick from Jak's water-vol falls through to the
                 ;; submerged branch below — it should just sync wedges
                 ;; silently, NOT kill Mario.  Routing every drown tick
                 ;; here previously was instant-killing Mario in 2 hits.
                 ((= mode 'drown-death)
                  (format #t "[sync-debug]   -> DROWN (fatal)~%")
                  (pc-sm64-drown-mario))
                 ((= mode 'endlessfall)
                  (format #t "[sync-debug]   -> ENDLESSFALL~%")
                  (pc-sm64-endlessfall-mario))
                 (submerged
                  (format #t "[sync-debug]   -> SET-WEDGES ~D (swim suppress, mode=~A)~%"
                          target-wedges mode)
                  (pc-sm64-set-mario-wedges target-wedges))
                 (else
                  (format #t "[sync-debug]   -> KNOCKBACK ~D wedges~%" damage-wedges)
                  (pc-sm64-knockback-mario damage-wedges)))))

            ;; (2) Mario lost wedges in libsm64 (lava bounce, drowning,
            ;; OOB, etc.) and Jak didn't — propagate to Jak as an attack
            ;; so Jak's HP catches up.  Don't change expected-next: Mario's
            ;; wedges already reflect the loss, no further drift.
            (mario-edge
             (let ((mario-mode (the int (-> *sm64-mario-damage* x)))
                   (submerged (> (-> *sm64-mario-damage* w) 0.5)))
               (format #t "[sync-debug] MARIO-EDGE mario-w:~D->prev:~D target:~D mode=~D submerged=~A~%"
                       mario-wedges (-> self prev-mario-wedges) target-wedges
                       mario-mode submerged)
               (cond
                 ((= mario-mode 1)
                  (format #t "[sync-debug]   -> JAK ATTACK 'lava (-1 hp)~%")
                  (send-event *target* 'attack-invinc #f
                              (static-attack-info ((mode 'lava)))))
                 ((= mario-mode 2)
                  (format #t "[sync-debug]   -> JAK ATTACK 'drown-death~%")
                  (send-event *target* 'attack-invinc #f
                              (static-attack-info ((mode 'drown-death)))))
                 ((= mario-mode 3)
                  (format #t "[sync-debug]   -> JAK ATTACK 'endlessfall~%")
                  (send-event *target* 'attack-invinc #f
                              (static-attack-info ((mode 'endlessfall)))))
                 (else
                  (let ((hp-loss (max 1 (/ (- (-> self prev-mario-wedges) mario-wedges) 2))))
                    (format #t "[sync-debug]   -> JAK ATTACK 'mario-sync x~D times~%" hp-loss)
                    (dotimes (i hp-loss)
                      ;; Use 'mario-sync so target-handler.gc can distinguish
                      ;; this from a real enemy hit and skip pc-sm64-damage-mario,
                      ;; preventing the knockback-loop (Mario damage → Jak attack
                      ;; → Mario knockback → repeat).
                      (send-event *target* 'attack #f
                                  (static-attack-info ((mode 'mario-sync))))))))))

            ;; (3) No edge fired — floor sync.
            ;; When going DOWN (damage), advance prev to target so next
            ;; frame's mario-edge doesn't re-fire on our own forced change.
            ;; When going UP (healing), do NOT advance prev — C++ won't
            ;; update *sm64-mario-health* until next tick, so the following
            ;; frame would see mario-wedges < prev-mario-wedges and falsely
            ;; fire mario-edge → attack Jak.  Leaving prev at mario-wedges
            ;; keeps the detector silent until the healed value arrives.
            ((!= mario-wedges target-wedges)
             (when (< target-wedges mario-wedges)
               (set! expected-next-mario-wedges target-wedges))
             (format #t "[sync-debug] FLOOR-SYNC mario-w:~D -> target:~D (jak-hp=~f eco=~f/~f)~%"
                     mario-wedges target-wedges jak-hp jak-eco jak-eco-max)
             (pc-sm64-set-mario-wedges target-wedges)))

           ;; Read Jak's health AFTER all send-event calls above so that
           ;; when mario-edge sent an attack to Jak this frame, next frame's
           ;; jak-edge detector sees no change (prev == new) and doesn't
           ;; fire a knockback back at Mario, breaking the damage cycle.
           (set! (-> self prev-jak-health) (if *target* (-> *target* fact health) 0.0))
           (set! (-> self prev-mario-wedges) expected-next-mario-wedges))))

      ;; ---- Track Mario's position ----
      (set! (-> self root trans x) (-> *sm64-mario-pos* x))
      (set! (-> self root trans y) (-> *sm64-mario-pos* y))
      (set! (-> self root trans z) (-> *sm64-mario-pos* z))

      ;; ---- Punch touch-tracker on rising edge ----
      (let ((attacking (> (-> *sm64-mario-info* x) 0.5)))
        (when (and attacking (not (-> self prev-attacking)))
          (let ((fist-pos (new 'stack-no-clear 'vector))
                (yaw (-> *sm64-mario-pos* w))
                (atk-scale (if (and *target* (= (-> *target* fact eco-type) (pickup-type eco-red)) (>= (-> *target* fact eco-level) 1.0)) 2.0 1.0)))
            (set-vector! fist-pos
              (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 1.5)))
              (+ (-> *sm64-mario-pos* y) (meters 1.0))
              (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 1.5)))
              1.0)
            (let ((tracker (sm64-spawn-attack-tracker self fist-pos (* (meters 1.7) atk-scale) 15 'punch)))
              (when tracker
                ;; Give it a callback that tracks Mario's fist each frame.
                (send-event (ppointer->process tracker) 'function
                  (lambda :behavior touch-tracker ()
                    (let ((yaw (-> *sm64-mario-pos* w)))
                      (set! (-> self root trans x)
                            (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 1.5))))
                      (set! (-> self root trans y)
                            (+ (-> *sm64-mario-pos* y) (meters 1.0)))
                      (set! (-> self root trans z)
                            (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 1.5)))))
                    (update-transforms! (-> self root))
                    (not (time-elapsed? (-> self state-time) (-> self duration)))))))))
        (set! (-> self prev-attacking) attacking))

      ;; ---- Ground-pound touch-tracker on impact rising edge ----
      (let ((gp-impact (> (-> *sm64-mario-info* y) 0.5)))
        (when (and gp-impact (not (-> self prev-ground-pound)))
          ;; Spawn at Mario's feet, large radius, short burst, 'flop attack
          (let ((feet-pos (new 'stack-no-clear 'vector))
                (atk-scale (if (and *target* (= (-> *target* fact eco-type) (pickup-type eco-red)) (>= (-> *target* fact eco-level) 1.0)) 2.0 1.0)))
            (set-vector! feet-pos
              (-> *sm64-mario-pos* x)
              (-> *sm64-mario-pos* y)
              (-> *sm64-mario-pos* z)
              1.0)
            (sm64-spawn-attack-tracker self feet-pos (* (meters 1.5) atk-scale) 10 'flop)))
        (set! (-> self prev-ground-pound) gp-impact))

      ;; ---- Ground pound invincibility (falling + impact) ----
      ;; Grant temporary invincibility to Jak while Mario is ground-pounding
      (let ((gp-falling (> (-> *sm64-mario-info* z) 0.5))
            (gp-impact (> (-> *sm64-mario-info* y) 0.5)))
        (when (and (or gp-falling gp-impact) *target*)
          (target-timed-invulnerable (seconds 0.01) *target*)))

      ;; ---- Dive touch-tracker on rising edge ----
      (let ((diving (> (-> *sm64-mario-info* w) 0.5)))
        (when (and diving (not (-> self prev-diving)))
          (let ((body-pos (new 'stack-no-clear 'vector))
                (yaw (-> *sm64-mario-pos* w))
                (atk-scale (if (and *target* (= (-> *target* fact eco-type) (pickup-type eco-red)) (>= (-> *target* fact eco-level) 1.0)) 2.0 1.0)))
            (set-vector! body-pos
              (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 1.5)))
              (+ (-> *sm64-mario-pos* y) (meters 0.3))
              (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 1.5)))
              1.0)
            (let ((tracker (sm64-spawn-attack-tracker self body-pos (* (meters 2.0) atk-scale) 80 'punch)))
              (when tracker
                ;; Track just ahead of Mario as he slides forward.
                (send-event (ppointer->process tracker) 'function
                  (lambda :behavior touch-tracker ()
                    (let ((yaw (-> *sm64-mario-pos* w)))
                      (set! (-> self root trans x)
                            (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 1.5))))
                      (set! (-> self root trans y)
                            (+ (-> *sm64-mario-pos* y) (meters 0.3)))
                      (set! (-> self root trans z)
                            (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 1.5)))))
                    (update-transforms! (-> self root))
                    (not (time-elapsed? (-> self state-time) (-> self duration)))))))))
        (set! (-> self prev-diving) diving))

      ;; ---- Slide-kick touch-tracker on rising edge ----
      (let ((slide-kicking (> (-> *sm64-mario-velocity* y) 0.5)))
        (when (and slide-kicking (not (-> self prev-slide-kick)))
          (let ((body-pos (new 'stack-no-clear 'vector))
                (yaw (-> *sm64-mario-pos* w))
                (atk-scale (if (and *target* (= (-> *target* fact eco-type) (pickup-type eco-red)) (>= (-> *target* fact eco-level) 1.0)) 2.0 1.0)))
            (set-vector! body-pos
              (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 1.5)))
              (+ (-> *sm64-mario-pos* y) (meters 0.3))
              (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 1.5)))
              1.0)
            (let ((tracker (sm64-spawn-attack-tracker self body-pos (* (meters 2.0) atk-scale) 80 'punch)))
              (when tracker
                (send-event (ppointer->process tracker) 'function
                  (lambda :behavior touch-tracker ()
                    (let ((yaw (-> *sm64-mario-pos* w)))
                      (set! (-> self root trans x)
                            (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 1.5))))
                      (set! (-> self root trans y)
                            (+ (-> *sm64-mario-pos* y) (meters 0.3)))
                      (set! (-> self root trans z)
                            (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 1.5)))))
                    (update-transforms! (-> self root))
                    (not (time-elapsed? (-> self state-time) (-> self duration)))))))))
        (set! (-> self prev-slide-kick) slide-kicking))

      ;; ---- Jump-kick touch-tracker on rising edge ----
      (let ((jump-kicking (> (-> *sm64-mario-velocity* z) 0.5)))
        (when (and jump-kicking (not (-> self prev-jump-kick)))
          (let ((kick-pos (new 'stack-no-clear 'vector))
                (yaw (-> *sm64-mario-pos* w))
                (atk-scale (if (and *target* (= (-> *target* fact eco-type) (pickup-type eco-red)) (>= (-> *target* fact eco-level) 1.0)) 2.0 1.0)))
            (set-vector! kick-pos
              (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 1.2)))
              (+ (-> *sm64-mario-pos* y) (meters 0.5))
              (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 1.2)))
              1.0)
            (let ((tracker (sm64-spawn-attack-tracker self kick-pos (* (meters 1.5) atk-scale) 12 'punch)))
              (when tracker
                (send-event (ppointer->process tracker) 'function
                  (lambda :behavior touch-tracker ()
                    (let ((yaw (-> *sm64-mario-pos* w)))
                      (set! (-> self root trans x)
                            (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 1.2))))
                      (set! (-> self root trans y)
                            (+ (-> *sm64-mario-pos* y) (meters 0.5)))
                      (set! (-> self root trans z)
                            (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 1.2)))))
                    (update-transforms! (-> self root))
                    (not (time-elapsed? (-> self state-time) (-> self duration)))))))))
        (set! (-> self prev-jump-kick) jump-kicking))

      ;; ---- Butt-slide touch-tracker (rising-edge only, like ground-pound) ----
      ;; og:preserve-this changed from continuous to rising-edge: one tracker fires when
      ;; Mario first enters the butt-slide state. Continuous spawning (even rate-limited)
      ;; causes bridge oscillation because the 8-tick tracker outlives the 5-tick 60fps frame,
      ;; hammering set-vel-from-impact on every bridge spring point every frame.
      (let ((butt-sliding (> (-> *sm64-mario-velocity* w) 0.5)))
        (when (and butt-sliding (not (-> self prev-butt-slide)))
          (let ((slide-pos (new 'stack-no-clear 'vector))
                (yaw (-> *sm64-mario-pos* w)))
            (set-vector! slide-pos
              (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 0.5)))
              (-> *sm64-mario-pos* y)
              (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 0.5)))
              1.0)
            (let ((tracker (sm64-spawn-attack-tracker self slide-pos (meters 1.5) 8 'flop)))
              (when tracker
                (send-event (ppointer->process tracker) 'function
                  (lambda :behavior touch-tracker ()
                    (let ((yaw (-> *sm64-mario-pos* w)))
                      (set! (-> self root trans x)
                            (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 0.5))))
                      (set! (-> self root trans y)
                            (-> *sm64-mario-pos* y))
                      (set! (-> self root trans z)
                            (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 0.5)))))
                    (update-transforms! (-> self root))
                    (not (time-elapsed? (-> self state-time) (-> self duration)))))))))
        (set! (-> self prev-butt-slide) butt-sliding))
      ;; ---- Shell riding: racer-like behavior ----
      (let ((on-shell (> (-> *sm64-mario-on-shell* x) 0.5)))
        ;; Rising edge: just mounted shell
        (when (and on-shell (not (-> self prev-on-shell)) *target*)
          (logior! (-> *target* control root-prim prim-core action) (collide-action racer))
          (set! (-> self shell-tracker-timer) 0)
          ;; Pull camera back and track faster for shell speed
          (set! (-> *camera* stringMaxLength) (meters 20))
          (set! (-> *camera* string-push-z) (meters 18))
          ;; Spawn the visual crab shell under Mario.  spawn-sm64-crab-shell
          ;; handles the entity-borrow / art-resolution internally; if the
          ;; current level has no borrowable entity (unusual — happens
          ;; during some teleport windows) it returns #f and we just live
          ;; without a visual for this mount.
          (let ((proc (spawn-sm64-crab-shell)))
            (when proc
              (set! (-> self shell-proc) (process->handle (ppointer->process proc))))))
        ;; Falling edge: just dismounted shell
        (when (and (not on-shell) (-> self prev-on-shell) *target*)
          (logclear! (-> *target* control root-prim prim-core action) (collide-action racer))
          ;; Restore default camera
          (set! (-> *camera* stringMaxLength) (-> *CAMERA-bank* default-string-max-z))
          (set! (-> *camera* string-push-z) (-> *CAMERA-bank* default-string-push-z))
          ;; Deactivate the visual crab shell if we spawned one.
          ;; handle->process returns #f for already-dead processes (e.g. the
          ;; shell self-terminated from its :trans invariant checks), so
          ;; the deactivate is skipped cleanly.
          (let ((shell (handle->process (-> self shell-proc))))
            (when shell (deactivate shell)))
          (set! (-> self shell-proc) (the-as handle #f)))
        ;; While on shell: spawn a touch-tracker every frame with 'racer attack
        ;; 12-frame duration with per-frame spawn ensures continuous coverage at any shell speed
        (when (and on-shell *target*)
          (+! (-> self shell-tracker-timer) 1)
          (let ((shell-pos (new 'stack-no-clear 'vector))
                (yaw (-> *sm64-mario-pos* w)))
            ;; Position slightly forward of Mario, matching racer attack sphere layout
            (set-vector! shell-pos
              (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 1.5)))
              (+ (-> *sm64-mario-pos* y) (meters 0.5))
              (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 1.5)))
              1.0)
            (let ((tracker (sm64-spawn-attack-tracker self shell-pos (meters 1.8) 12 'racer))) ;; if this is TOO LOW, mario bonks on crates and loses shell when going fast
                (when tracker
                  ;; Track ahead of Mario as he moves
                  (send-event (ppointer->process tracker) 'function
                    (lambda :behavior touch-tracker ()
                      (let ((yaw (-> *sm64-mario-pos* w)))
                        (set! (-> self root trans x)
                              (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 1.5))))
                        (set! (-> self root trans y)
                              (+ (-> *sm64-mario-pos* y) (meters 0.5)))
                        (set! (-> self root trans z)
                              (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 1.5)))))
                      (update-transforms! (-> self root))
                      (not (time-elapsed? (-> self state-time) (-> self duration)))))))))
        (set! (-> self prev-on-shell) on-shell))

      ;; ---- L1+L3 button: put Mario on shell anywhere ----
      ;; Hold L1 and press L3 to mount Mario on the shell
      ;; only in levels that have a racer (misty, rolling, lavatube, firecanyon, ogre).
      ;; Only works in debug mode.
      (when (and *cheat-mode* (cpad-hold? 0 r1) (cpad-pressed? 0 l3))
        (let ((cur-level (level-get-target-inside *level*)))
          (when (and cur-level
                     (or (= (-> cur-level name) 'misty)
                         (= (-> cur-level name) 'rolling)
                         (= (-> cur-level name) 'lavatube)
                         (= (-> cur-level name) 'firecanyon)
                         (= (-> cur-level name) 'ogre)))
            (set! *sm64-skip-zoomer* #t)
            (set! *sm64-zoomer-requested* #t))))

      ;; ---- Debug draw ----
      ;; keep this
    ;;   (when *debug-segment*
    ;;     (let ((dp (new 'stack-no-clear 'vector))
    ;;           (yaw (-> *sm64-mario-pos* w)))
    ;;       ;; Body area — red (Mario's approximate hitbox)
    ;;       (set-vector! dp
    ;;         (-> *sm64-mario-pos* x)
    ;;         (+ (-> *sm64-mario-pos* y) (meters 1.0))
    ;;         (-> *sm64-mario-pos* z)
    ;;         1.0)
    ;;       (add-debug-sphere #t (bucket-id debug-no-zbuf) dp (meters 1.2)
    ;;         (new 'static 'rgba :r #xff :g #x40 :b #x40 :a #x80))
    ;;       ;; Punch reach — yellow
    ;;       (set-vector! dp
    ;;         (+ (-> *sm64-mario-pos* x) (* (sin yaw) (meters 1.5)))
    ;;         (+ (-> *sm64-mario-pos* y) (meters 1.0))
    ;;         (+ (-> *sm64-mario-pos* z) (* (cos yaw) (meters 1.5)))
    ;;         1.0)
    ;;       (add-debug-sphere #t (bucket-id debug-no-zbuf) dp (meters 1.5)
    ;;         (new 'static 'rgba :r #xff :g #xff :b #x00 :a #x80))
    ;;       ;; Ground-pound AoE — blue (only while falling or impact)
    ;;       (when (> (+ (-> *sm64-mario-info* y) (-> *sm64-mario-info* z)) 0.5)
    ;;         (set-vector! dp
    ;;           (-> *sm64-mario-pos* x)
    ;;           (-> *sm64-mario-pos* y)
    ;;           (-> *sm64-mario-pos* z)
    ;;           1.0)
    ;;         (add-debug-sphere #t (bucket-id debug-no-zbuf) dp (meters 3.0)
    ;;           (new 'static 'rgba :r #x40 :g #x40 :b #xff :a #x80)))))

      (suspend)))
  :trans (behavior ()
    ;; ---- HP desync overlay --------------------------------------------
    ;; Per-frame on-screen readout of Jak HP + Mario HP (raw values).
    ;; The hud-health meter is driven by Mario's health/2 via the
    ;; defmethod override above, so eye-balling the two numbers side
    ;; by side is the easiest way to spot the sync path glitching
    ;; (e.g. Mario takes lava damage but the bridge didn't relay it to
    ;; Jak, or vice versa).  Highlights red when they disagree.
    ;;
    ;; Eco-pill counts as an extra hit for Jak: a full pill
    ;; (fact.eco-pill >= eco-pill-max, default 50) means Jak has a
    ;; shield wedge he can soak a hit on, so we treat him as having
    ;; jak-hp + 1 effective health whenever the pill is maxed.  The
    ;; sync invariant is therefore `mario-hp == 2 * effective-jak-hp`
    ;; — e.g. full Jak (3 HP + full pill = 4 effective) matches Mario
    ;; at 8 wedges.
    ;;
    ;; Visibility gates:
    ;;   - no *progress-process*    (start menu obscures the HUD)
    ;;   - not in a movie
    ;;   - hud-health exists AND isn't in the `hud-hidden` state
    ;;     (catches cutscenes, letterbox/blackout, target-grabbed —
    ;;      all the cases the HUD's own visibility machinery covers)
    ;; so the overlay only draws while Jak's normal HUD is on screen.
    ;;
    ;; Why this lives in `:trans` rather than `:code`: GOAL's main-
    ;; thread backup-stack is hard-capped at PROCESS_STACK_SAVE_SIZE =
    ;; 256 bytes (kernel/gkernel-h.gc:58), which is what the kernel
    ;; copies aside on `(suspend)`.  The overlay's combined peak
    ;; (stack-allocated font-context + string-format frame + print-game
    ;; -text call chain) pushes past 256B and the kernel bails — so
    ;; we draw in `:trans`, which never suspends itself.
    (when (and *target*
               (not *progress-process*)
               (not (movie?))
               (-> *hud-parts* health)
               (not (hidden? (-> *hud-parts* health 0))))
      (let* ((jak-hp          (the int (-> *target* fact health)))
             (jak-hp-max      (the int (-> *target* fact health-max)))
             (full-pill?      (>= (-> *target* fact eco-pill)
                                  (-> *target* fact eco-pill-max)))
             ;; A full 50-unit eco pill counts as an extra hit slot —
             ;; it's the shield Jak can eat before real damage starts.
             ;; So effective HP = health + (full-pill ? 1 : 0), and the
             ;; max HP the HUD can ever show = health-max + 1.
                          ;; Clamp to 0 when Jak is dead — the pill buffer doesn't
             ;; grant an effective hit-point on a dead Jak.
             (effective-jak   (if (<= jak-hp 0) 0 (+ jak-hp (if full-pill? 1 0))))
             (effective-max   (+ jak-hp-max 1))
             (mario-hp        (the int (-> *sm64-mario-health* x)))
             (desync?         (!= (* effective-jak 2) mario-hp))
             (ctx             (new 'stack 'font-context *font-default-matrix* 20 50 0.0
                                   (font-color default) (font-flags shadow kerning))))
        (when desync?
          (set! (-> ctx color) (font-color red)))
        (print-game-text
          (string-format "Jak HP: ~D/~D   Mario HP: ~D/8~A"
                         effective-jak
                         effective-max
                         mario-hp
                         (if desync? "  [DESYNC]" ""))
          ctx #f 128 22))))
  :post ja-post)

;; ---- Init + spawn -----------------------------------------------------------

(defbehavior sm64-mario-col-init sm64-mario-col ()
  "Initialize and enter idle."
  ;; Clear pause / menu / progress bits from our mask so the idle loop
  ;; keeps ticking when Jak's game is paused, the debug menu is open,
  ;; or the start-menu (progress screen) is up.  This is what lets
  ;; `update-mario-music!` pick up the load-game → file-select track
  ;; override the instant the progress screen opens — without this, the
  ;; default-pool-inherited mask (`pause menu progress process-tree`,
  ;; see gkernel.gc:2045) gates our entire behavior off during those
  ;; modes and the music stays on the previous level's track.  Same
  ;; pattern as `sage-finalboss.gc:599` / `anim-tester-x.gc:395`.  All
  ;; other work in the idle loop (Mario death detection, health sync,
  ;; target-flags, shell respawn timer) is either `(when *target* ...)`
  ;; guarded or cheap bookkeeping, so it's safe to keep ticking.
  (logclear! (-> self mask) (process-mask pause menu progress))
  (stack-size-set! (-> self main-thread) 512)
  (set! (-> self root) (new 'process 'trsqv))
  (set! (-> self root trans quad) (-> *sm64-mario-pos* quad))
  (set! (-> self prev-attacking) #f)
  (set! (-> self prev-ground-pound) #f)
  (set! (-> self prev-diving) #f)
  (set! (-> self mario-dead) #t)
  (set! (-> self death-timer) 0)
  (set! (-> self prev-jak-health) 0.0)
  (set! (-> self prev-on-shell) #f)
  (set! (-> self shell-tracker-timer) 0)
  (set! (-> self shell-proc) (the-as handle #f))
  (go-virtual idle))

(defun sm64-mario-col-start ()
  "Spawn the Mario collision tracker.  Safe to call multiple times."
  (let ((existing (process-by-name "sm64-mario-col" *active-pool*)))
    (when existing
      (deactivate existing)))
  (process-spawn sm64-mario-col :init sm64-mario-col-init :name "sm64-mario-col")
  (format #t "[sm64] Mario collision process started~%"))

(defun sm64-mario-col-stop ()
  "Kill the Mario collision process."
  (let ((proc (process-by-name "sm64-mario-col" *active-pool*)))
    (when proc
      (deactivate proc)
      (format #t "[sm64] Mario collision process stopped~%"))))

;; Auto-start on load.
(sm64-mario-col-start)

;; ---------------------------------------------------------------------------
;; crab-test — smoke test for the global lurker-crab actor.
;;
;; Flow: spawn a background process that waits 6 seconds, then spawns a
;; real `lurkercrab` near Mario but OUTSIDE its notice-distance so the
;; crab's nav-enemy AI doesn't immediately acquire Jak/Mario as a target.
;;
;; Why 40m: `*lurkercrab-nav-enemy-info*` (lurkercrab.gc) has
;; `:notice-distance (meters 25)` — crabs wake and charge when Jak is
;; within 25m.  We place at +40m in X so the crab spawns in patrol-idle
;; and stays there until we approach.
;;
;; Art-group + code come from GAME.CGO (see game.gd — `lurkercrab.o` +
;; `lurkercrab-ag.go` are promoted globally).  Textures (tpage-212..215)
;; are NOT global yet — beach has them natively; other levels will show
;; untextured merc geo if you run this test there.  That's fine for a
;; "does the type exist / spawn / init-from-entity! succeed" smoke test.
;;
;; We piggy-back on an arbitrary live entity from the current level so
;; `init-from-entity!` → `process-drawable-from-entity!` → the art-group
;; level lookup inside `initialize-skeleton` all use the real
;; current-level path instead of falling through to level-default
;; (which was the bug that caused file-stream type corruption earlier).
;; The entity slot is cleared after init so our eventual deactivate
;; doesn't invoke entity-deactivate-handler on the borrowed actor.
;; ---------------------------------------------------------------------------

(defun crab-test-find-entity ()
  "Return any live entity-actor from the currently loaded level, or #f."
  (when *level*
    (let ((lev (level-get-target-inside *level*)))
      (when (and lev
                 (= (-> lev status) 'active)
                 (-> lev bsp)
                 (-> lev bsp level)
                 (-> lev bsp level entity)
                 (> (-> lev bsp level entity length) 0))
        (-> lev bsp level entity data 0 entity)))))

(defun crab-test ()
  "Wait 6s, then spawn a lurker crab ~40m from Mario (outside notice-distance).
   Logs to stdout so you can watch the sequence in the console."
  (process-spawn-function process
    (lambda :behavior process ()
      (format 0 "[crab-test] driver started, waiting 6s~%")
      (let ((t0 (current-time)))
        (while (not (time-elapsed? t0 (seconds 6.0)))
          (suspend)))
      (let ((ent (crab-test-find-entity)))
        (cond
          ((not ent)
           (format 0 "[crab-test] no live level entity to borrow — abort~%"))
          (else
           (format 0 "[crab-test] spawning lurker crab near Mario (+40m X)~%")
           (process-spawn lurkercrab
             :init
             (lambda :behavior lurkercrab ((borrowed entity-actor))
               ;; Wire the borrowed entity so initialize-skeleton walks
               ;; the current level's art-group load-dir (not
               ;; level-default).
               (set! (-> self entity) borrowed)
               (init-from-entity! self borrowed)
               ;; init-from-entity! just placed the crab at the borrowed
               ;; entity's world trans — reposition to Mario + offset
               ;; so it stands near-but-not-on top of Jak/Mario.  Using
               ;; collide-info trans because lurkercrab's root is a
               ;; collide-shape-moving (set up by init-from-entity!).
               (when (and (-> self collide-info) *sm64-mario-pos*)
                 (set! (-> self collide-info trans x)
                       (+ (-> *sm64-mario-pos* x) (meters 40)))
                 (set! (-> self collide-info trans y) (-> *sm64-mario-pos* y))
                 (set! (-> self collide-info trans z) (-> *sm64-mario-pos* z))
                 (set! (-> self collide-info trans w) 1.0))
               ;; Unhook the borrowed entity so our deactivate doesn't
               ;; touch the real actor's entity record.
               (set! (-> self entity) (the-as entity-actor #f))
               (none))
             :name "crab-test"
             ent))))
      (none))
    :name "crab-test-driver"
    :from *4k-dead-pool*)
  (none))
